<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Let IIS know to use iisnode for server.js -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" resourceType="Unspecified" />
    </handlers>

    <!-- Route all requests to server.js so Express handles APIs + static files -->
    <rewrite>
      <rules>
        <rule name="NodeJS_Route_All" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Serve static files (CSS, JS, images, etc.) -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <mimeMap fileExtension=".html" mimeType="text/html" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
    </staticContent>

    <!-- iisnode logging -->
    <iisnode loggingEnabled="true" logDirectory="iisnode" />

    <!-- Optional: ensure correct node environment -->
    <environmentVariables>
      <environmentVariable name="NODE_ENV" value="production" />
    </environmentVariables>

  </system.webServer>
</configuration>
